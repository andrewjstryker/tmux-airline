# shellcheck project configuration.

# SC1091: runtime paths locate sibling layers and user-selected helpers; every
# shipped file is checked independently by the Makefile.
# SC2119/SC2120: argument-bearing calls into api.sh live in the separately
# checked `airline` CLI, so ShellCheck sees only the zero-argument internal calls.
# SC2317: sourced library guards use `return ... || exit` so they fail cleanly
# both when sourced and when invoked directly; ShellCheck sees the exit as
# unreachable when analyzing a file in only one of those contexts.
disable=SC1091,SC2119,SC2120,SC2317
