# shellcheck project configuration.

# SC1091: airline.tmux and the `airline` CLI source sibling scripts by runtime
# path (scripts/*.sh, plugins/*). shellcheck can't follow those statically and
# we don't want it to — the files are checked on their own. Don't-follow policy.
disable=SC1091

# SC2120/SC2119: load_theme takes an optional theme name. Production calls it
# with no argument (it falls back to the @airline-theme option); the test
# harness passes one. shellcheck only sees the in-file (zero-arg) calls and
# flags the optional parameter. The design is intentional.
disable=SC2119,SC2120
