# Default segment set — dependency-free.
#
# A plain tmux conf: `segment use default` loads it (and `layout use default` runs a
# composition that uses it). It uses only built-in tmux format variables, so a fresh
# install renders a real bar with no third-party plugins. Widget content (cpu, online,
# prefix, battery) is added by a layout that also `adapter use`s the plugin.

set -g @airline-segment-left-out  "#S"                 # session name
set -g @airline-segment-right-mid "#h"                 # short hostname
set -g @airline-segment-right-out "%Y-%m-%d %H:%M"     # date + time

# vim: ft=tmux
