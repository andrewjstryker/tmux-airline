#!/usr/bin/env bash
# Private bounded worker. Observation code never runs in the configuration process.
file="$1"; shift
# shellcheck source=/dev/null
source "$file" || exit
if ! declare -F airline_widget_sample >/dev/null; then
  echo 'widget has no airline_widget_sample function' >&2
  exit 2
fi
airline_widget_sample "$@"
