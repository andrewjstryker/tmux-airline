_airline_zsh_dynamic () {
  local type="$1" noun
  case "$type" in
    palette|adapter|layout|classifier|filter|probe|runner)
      command airline "$type" list 2>/dev/null
      ;;
    palette-element) command airline palette show 2>/dev/null | awk '$1 != "name" {print $1}' ;;
    segment) command airline segment show 2>/dev/null | awk '{print $1}' ;;
    health-contributor) command airline health show 2>/dev/null | awk '{print $1}' | sort -u ;;
    health-key) command airline health show 2>/dev/null | awk '{print $2}' | sort -u ;;
    problem-contributor) command airline problem show --all 2>/dev/null | awk '$1 !~ /^(pane|session):/ {print $1}' | sort -u ;;
    problem-key) command airline problem show --all 2>/dev/null | awk '$1 !~ /^(pane|session):/ {print $2}' | sort -u ;;
    session) command tmux list-sessions -F '#{session_name}' 2>/dev/null ;;
    pane-id) command tmux list-panes -a -F '#{pane_id}' 2>/dev/null ;;
    window) command tmux list-windows -a -F '#{window_id}' 2>/dev/null ;;
  esac
}

_airline_zsh_describe_children () {
  local parent="$1" child
  local -a values
  for child in ${=_airline_children "$parent"}; do
    values+=("$child:$(_airline_description "${parent:+$parent }$child")")
  done
  _describe 'airline command' values
}

_airline_zsh () {
  local top="${words[2]:-}" verb path previous semantic base
  if (( CURRENT == 2 )); then _airline_zsh_describe_children ''; return; fi
  if [[ "$top" == help ]]; then
    if (( CURRENT == 3 )); then _airline_zsh_describe_children ''; return; fi
    if (( CURRENT == 4 )); then _airline_zsh_describe_children "${words[3]}"; return; fi
    return
  fi
  if [[ -n "$(_airline_children "$top")" ]]; then
    if (( CURRENT == 3 )); then _airline_zsh_describe_children "$top"; return; fi
    verb="${words[3]}"; path="$top $verb"
  else
    path="$top"
  fi
  previous="${words[CURRENT-1]:-}"
  case "$previous" in
    --classify) compadd ${(@f)$(_airline_zsh_dynamic classifier)}; return ;;
    --filter) compadd ${(@f)$(_airline_zsh_dynamic filter)}; return ;;
    --probe) compadd ${(@f)$(_airline_zsh_dynamic probe)}; return ;;
    -t)
      if [[ "$path" == 'session init' ]]; then semantic=session
      elif [[ "$path" == 'status set' || "$path" == 'status clear' ]]; then semantic=pane-id
      else semantic=window; fi
      compadd ${(@f)$(_airline_zsh_dynamic "$semantic")}; return
      ;;
  esac
  if [[ "$path" == 'runner run' || "$path" == 'runner watch' ]]; then
    if (( ${words[(I)--]} )); then [[ "$path" == 'runner run' ]] && _normal; return; fi
    local -a runner_options=(--here --pane --window -h -v --probe)
    [[ "$path" == 'runner run' ]] && runner_options+=(--classify --filter --merge-stderr --)
    if [[ "$PREFIX" == -* ]]; then compadd -- $runner_options
    elif (( CURRENT == 4 )); then compadd ${(@f)$(_airline_zsh_dynamic runner)} $runner_options
    fi
    return
  fi
  case "$path" in
    'status set')
      if [[ "$PREFIX" == -* ]]; then compadd -- -t; return
      elif (( CURRENT == 4 )); then compadd active result attention; return
      fi
      ;;
    'status clear')
      [[ "$PREFIX" == -* ]] && { compadd -- -t; return; }
      ;;
    'health set')
      base=4; [[ "${words[4]:-}" == -t ]] && base=6
      if (( CURRENT == base )); then
        compadd ${(@f)$(_airline_zsh_dynamic health-contributor)} -t; return
      elif (( CURRENT == base + 1 )); then
        compadd ${(@f)$(_airline_zsh_dynamic health-key)}; return
      elif (( CURRENT == base + 2 )); then compadd ok warn fail; return
      fi
      ;;
    'health clear'|'health show')
      base=4; [[ "${words[4]:-}" == -t ]] && base=6
      if (( CURRENT == base )); then
        compadd ${(@f)$(_airline_zsh_dynamic health-contributor)} -t; return
      elif (( CURRENT == base + 1 )); then
        compadd ${(@f)$(_airline_zsh_dynamic health-key)}; return
      fi
      ;;
    'problem set')
      if [[ "${words[4]:-}" == --pane ]]; then
        if (( CURRENT == 5 )); then semantic=pane-id
        elif (( CURRENT == 6 )); then semantic=problem-contributor
        elif (( CURRENT == 7 )); then semantic=problem-key
        elif (( CURRENT == 8 )); then compadd ok warn fail; return
        fi
      elif (( CURRENT == 4 )); then compadd ${(@f)$(_airline_zsh_dynamic problem-contributor)} --pane; return
      elif (( CURRENT == 5 )); then semantic=problem-key
      elif (( CURRENT == 6 )); then compadd ok warn fail; return
      fi
      ;;
    'problem close')
      if [[ "${words[4]:-}" == --pane ]]; then
        if (( CURRENT == 5 )); then semantic=pane-id
        elif (( CURRENT == 6 )); then semantic=problem-contributor
        elif (( CURRENT == 7 )); then semantic=problem-key
        fi
      elif [[ "${words[4]:-}" == --session ]]; then
        if (( CURRENT == 5 )); then semantic=session-id
        elif (( CURRENT == 6 )); then semantic=problem-contributor
        elif (( CURRENT == 7 )); then semantic=problem-key
        fi
      elif (( CURRENT == 4 )); then compadd ${(@f)$(_airline_zsh_dynamic problem-contributor)} --pane --session; return
      elif (( CURRENT == 5 )); then semantic=problem-key
      fi
      ;;
    'problem clear'|'problem resolve')
      if (( CURRENT == 4 )); then semantic=problem-contributor
      elif (( CURRENT == 5 )); then semantic=problem-key
      fi ;;
    'problem show')
      if (( CURRENT == 4 )); then compadd ${(@f)$(_airline_zsh_dynamic problem-contributor)} --all; return
      elif (( CURRENT == 5 )); then semantic=problem-key
      fi
      ;;
    'transaction clear')
      if (( CURRENT == 4 )); then compadd global session window; return
      elif (( CURRENT == 5 )); then
        [[ "${words[4]}" == global ]] && compadd server || compadd ${(@f)$(_airline_zsh_dynamic "${words[4]}")}
        return
      elif (( CURRENT == 6 )); then
        case "${words[4]}" in
          global) compadd problem ;;
          session) compadd config ;;
          window) compadd status health ;;
        esac
        return
      fi
      ;;
    'palette use') semantic=palette ;; 'adapter use') semantic=adapter ;;
    'layout use') semantic=layout ;; 'classifier show') semantic=classifier ;;
    'filter show') semantic=filter ;; 'probe show') semantic=probe ;;
    'runner show') semantic=runner ;;
    'palette show') compadd name ${(@f)$(_airline_zsh_dynamic palette-element)}; return ;;
    'layout show') compadd name path; return ;;
    'segment show') semantic=segment ;;
    *' register') _files -/; return ;; *' load') _files; return ;;
  esac
  [[ -z "$semantic" ]] || compadd ${(@f)$(_airline_zsh_dynamic "$semantic")}
}

compdef _airline_zsh airline
