#!/usr/bin/env bash
# Full layout — every plugin this project adapts (cpu / battery / online / prefix).
# Assumes the plugins are installed; use `adaptive` to light up only what's present.
airline_layout_configure () {
  local declare="$1"
  "$declare" adapter use cpu battery online prefix-highlight
  "$declare" segment left-out  "#S"
  "$declare" segment left-mid  "#{online_status}"
  "$declare" segment right-in  "#{prefix_highlight}"
  "$declare" segment right-mid "#{cpu_fg_color}#{cpu_icon}"
  "$declare" segment right-out "%Y-%m-%d %H:%M #{battery_color_fg}#{battery_icon}"
}
