#!/usr/bin/env bash
#| summary: Reachability of a chosen host through ICMP
#| usage: [--host <host>] [--timeout <seconds>] [--online-icon <text>] [--offline-icon <text>]
#| options: host timeout online-icon offline-icon
#| default-host: 1.1.1.1
#| default-timeout: 1
#| default-online-icon: ●
#| default-offline-icon: ●
#| interval: 10
#| timeout: 10
_online_options() {
  ONLINE_HOST=1.1.1.1 ONLINE_TIMEOUT=1 ONLINE_ICON=● OFFLINE_ICON=●
  while (( $# )); do
    # options:begin
    case "$1" in
      --host) [[ $# -ge 2 ]] || return 2; ONLINE_HOST="$2"; shift 2 ;; #| <host> — ICMP target, default 1.1.1.1
      --timeout) [[ $# -ge 2 ]] || return 2; ONLINE_TIMEOUT="$2"; shift 2 ;; #| <seconds> — ping timeout, 1 through 8
      --online-icon) [[ $# -ge 2 ]] || return 2; ONLINE_ICON="$2"; shift 2 ;; #| <text> — reachable icon
      --offline-icon) [[ $# -ge 2 ]] || return 2; OFFLINE_ICON="$2"; shift 2 ;; #| <text> — unreachable icon
      *) return 2 ;;
    esac
    # options:end
  done
  [[ "$ONLINE_TIMEOUT" =~ ^[1-8]$ ]] || return 2
  [[ "$ONLINE_HOST" =~ ^[a-zA-Z0-9][a-zA-Z0-9.:%_-]*$ ]]
}
airline_widget_available() { command -v ping >/dev/null || return 3; }
airline_widget_format() {
  _online_options "$@" || return 2
  local value; value="$(widget_reading)"
  printf '%s#[fg=#{?#{==:%s,1},#{@airline-primary},#{@airline-stress}}]#{?#{==:%s,1},%s,#{?#{==:%s,0},%s,—}}' \
    "$(widget_job)" "$value" "$value" "$(widget_text "$ONLINE_ICON")" "$value" "$(widget_text "$OFFLINE_ICON")"
}
airline_widget_sample() {
  _online_options "$@" || return 2
  local rc=0
  ping -n -c 1 -W "$ONLINE_TIMEOUT" "$ONLINE_HOST" >/dev/null 2>&1 || rc=$?
  case "$rc" in 0) printf '1\n' ;; 1) printf '0\n' ;; *) return "$rc" ;; esac
}
