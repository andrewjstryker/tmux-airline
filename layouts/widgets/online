#!/usr/bin/env bash
# Read NetworkManager's existing observation; do not request a connectivity check.
export LC_ALL=C
unknown() { printf 'unknown\n'; exit 0; }
connectivity="$(nmcli --colors no -t -f CONNECTIVITY general status 2>/dev/null)" || unknown
case "$connectivity" in
  none) printf 'disconnected\n'; exit 0 ;;
  full) health=full ;;
  limited|portal) health=limited ;;
  *) unknown ;;
esac
devices="$(nmcli --colors no -t -f DEVICE,TYPE,STATE device status 2>/dev/null)" || unknown
declare -A types=()
first=''
while IFS=: read -r device type state; do
  [[ "$state" == connected* ]] || continue
  case "$type" in ethernet) type=wired ;; wifi) type=wireless ;; *) continue ;; esac
  types["$device"]="$type"
  [[ -n "$first" ]] || first="$device"
done <<< "$devices"
[[ -n "$first" ]] || unknown

# Prefer the lowest-metric physical default route. VPN/tunnel devices do not
# replace the underlying wired/wireless identity. Prefer IPv4, then IPv6.
selected=''
for family in -4 -6; do
  routes="$(ip "$family" -o route show default 2>/dev/null)" || unknown
  best_metric=2147483647
  while read -r -a words; do
    device=''; metric=0
    for ((i=0; i<${#words[@]}-1; i++)); do
      case "${words[i]}" in
        dev) device="${words[i+1]}" ;;
        metric) metric="${words[i+1]}" ;;
      esac
    done
    [[ -n "$device" && -n "${types[$device]:-}" && "$metric" =~ ^[0-9]+$ ]] || continue
    if (( metric < best_metric )); then selected="$device"; best_metric="$metric"; fi
  done <<< "$routes"
  [[ -z "$selected" ]] || break
done
# A local-only connection need not have a default route.
if [[ -z "$selected" ]]; then
  [[ "$health" == limited ]] || unknown
  selected="$first"
fi
printf '%s %s\n' "${types[$selected]}" "$health"
