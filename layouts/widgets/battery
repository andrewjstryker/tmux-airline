#!/usr/bin/env bash
#| summary: Linux battery capacity (first system battery)
#| usage: [--display <compact|both>] [--charging-icon <text>] [--discharging-icon <text>]
#| options: display charging-icon discharging-icon
#| default-display: compact
#| default-charging-icon: ⚡
#| default-discharging-icon: 🔋
#| interval: 30
#| timeout: 1
_battery_device() {
  local device type
  for device in "${AIRLINE_POWER_SUPPLY:-/sys/class/power_supply}"/*; do
    [[ -r "$device/type" && -r "$device/capacity" ]] || continue
    read -r type < "$device/type"
    [[ "$type" == Battery ]] || continue
    printf '%s' "$device"; return 0
  done
  return 3
}
airline_widget_available() { _battery_device >/dev/null; }
_battery_options() {
  BATTERY_DISPLAY=compact BATTERY_CHARGING_ICON=⚡ BATTERY_DISCHARGING_ICON=🔋
  while (( $# )); do
    # options:begin
    case "$1" in
      --display) [[ $# -ge 2 ]] || return 2; BATTERY_DISPLAY="$2"; shift 2 ;; #| <compact|both> — switching icon or meter plus status
      --charging-icon) [[ $# -ge 2 ]] || return 2; BATTERY_CHARGING_ICON="$2"; shift 2 ;; #| <text> — charging/full/attached icon
      --discharging-icon) [[ $# -ge 2 ]] || return 2; BATTERY_DISCHARGING_ICON="$2"; shift 2 ;; #| <text> — discharge icon in both mode
      *) return 2 ;;
    esac
    # options:end
  done
  [[ "$BATTERY_DISPLAY" == compact || "$BATTERY_DISPLAY" == both ]]
}
airline_widget_format() {
  _battery_options "$@" || return 2
  local reading value meter='▁' tier capacity power status charging discharging
  reading="$(widget_reading)"
  # Samples contain capacity:status; keep presentation in live tmux formats.
  value="#{s/[^0-9].*//:${reading:2:-1}}"
  for tier in '6 ▂' '20 ▃' '35 ▄' '50 ▅' '65 ▆' '80 ▇' '95 █'; do
    meter="#{?#{e|>=:$value,${tier%% *}},${tier#* },$meter}"
  done
  printf -v capacity '#[fg=#{?#{e|>=:%s,80},#{@airline-primary},#{?#{e|>=:%s,50},#{@airline-emphasized},#{?#{e|>=:%s,20},#{@airline-alert},#{@airline-stress}}}}]#{?#{m/r:^[0-9]+$,%s},%s,—}' \
    "$value" "$value" "$value" "$value" "$meter"
  charging="$(widget_text "$BATTERY_CHARGING_ICON")"
  discharging="$(widget_text "$BATTERY_DISCHARGING_ICON")"
  power="#{m/r::(charging|full|attached)$,$reading}"
  printf -v status '#[fg=#{?#{m:*:charging,%s},#{@airline-active},#{?#{m:*:discharging,%s},#{@airline-emphasized},#{@airline-primary}}}]#{?#{m:*:discharging,%s},%s,#{?%s,%s,}}' \
    "$reading" "$reading" "$reading" "$discharging" "$power" "$charging"
  widget_job
  if [[ "$BATTERY_DISPLAY" == both ]]; then printf '%s%s' "$capacity" "$status"
  else printf '#{?%s,%s,%s}' "$power" "$status" "$capacity"; fi
}
airline_widget_sample() {
  _battery_options "$@" || return 2
  local device value status=unknown
  device="$(_battery_device)" || return
  read -r value < "$device/capacity" || return
  [[ "$value" =~ ^[0-9]{1,3}$ ]] || return 2
  value=$((10#$value)); (( value <= 100 )) || return 2
  if [[ -r "$device/status" ]]; then read -r status < "$device/status" || status=unknown; fi
  case "$status" in
    Charging) status=charging ;;
    Discharging) status=discharging ;;
    Full) status=full ;;
    'Not charging') status=attached ;;
    *) status=unknown ;;
  esac
  printf '%s:%s\n' "$value" "$status"
}
