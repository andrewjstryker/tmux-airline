#!/usr/bin/env bash
#| summary: CPU utilization from Linux counter deltas
#| usage: [--warn <percent>] [--critical <percent>] [--meter-medium <percent>] [--meter-high <percent>] [--low-icon <text>] [--medium-icon <text>] [--high-icon <text>]
#| options: warn critical meter-medium meter-high low-icon medium-icon high-icon
#| default-warn: 70
#| default-critical: 90
#| default-meter-medium: 30
#| default-meter-high: 80
#| default-low-icon: =
#| default-medium-icon: ≡
#| default-high-icon: ≣
#| interval: 5
#| timeout: 1

_cpu_options () {
  CPU_WARN=70 CPU_CRITICAL=90 CPU_MEDIUM=30 CPU_HIGH=80
  CPU_LOW_ICON="=" CPU_MEDIUM_ICON="≡" CPU_HIGH_ICON="≣"
  while (( $# )); do
    # options:begin
    case "$1" in
      --warn) [[ $# -ge 2 ]] || return 2; CPU_WARN="$2"; shift 2 ;; #| <percent> — warning threshold, default 70
      --critical) [[ $# -ge 2 ]] || return 2; CPU_CRITICAL="$2"; shift 2 ;; #| <percent> — critical threshold, default 90
      --meter-medium) [[ $# -ge 2 ]] || return 2; CPU_MEDIUM="$2"; shift 2 ;; #| <percent> — medium meter level, default 30
      --meter-high) [[ $# -ge 2 ]] || return 2; CPU_HIGH="$2"; shift 2 ;; #| <percent> — high meter level, default 80
      --low-icon) [[ $# -ge 2 ]] || return 2; CPU_LOW_ICON="$2"; shift 2 ;; #| <text> — low utilization icon
      --medium-icon) [[ $# -ge 2 ]] || return 2; CPU_MEDIUM_ICON="$2"; shift 2 ;; #| <text> — medium utilization icon
      --high-icon) [[ $# -ge 2 ]] || return 2; CPU_HIGH_ICON="$2"; shift 2 ;; #| <text> — high utilization icon
      *) echo "cpu: unknown option $1" >&2; return 2 ;;
    esac
    # options:end
  done
  [[ "$CPU_WARN" =~ ^[0-9]{1,3}$ && "$CPU_CRITICAL" =~ ^[0-9]{1,3}$ ]] || return 2
  CPU_WARN=$((10#$CPU_WARN)); CPU_CRITICAL=$((10#$CPU_CRITICAL))
  [[ "$CPU_MEDIUM" =~ ^[0-9]{1,3}$ && "$CPU_HIGH" =~ ^[0-9]{1,3}$ ]] || return 2
  CPU_MEDIUM=$((10#$CPU_MEDIUM)); CPU_HIGH=$((10#$CPU_HIGH))
  (( CPU_WARN <= CPU_CRITICAL && CPU_CRITICAL <= 100 && CPU_MEDIUM <= CPU_HIGH && CPU_HIGH <= 100 ))
}
airline_widget_available () { [[ -r /proc/stat ]] || { echo 'CPU counters require Linux /proc/stat' >&2; return 3; }; }
airline_widget_format () {
  _cpu_options "$@" || return 2
  local value; value="$(widget_reading)"
  printf '%s#[fg=#{?#{e|>=:%s,%s},#{@airline-stress},#{?#{e|>=:%s,%s},#{@airline-alert},#{@airline-secondary}}}]#{?#{m/r:^[0-9]+$,%s},#{?#{e|>=:%s,%s},%s,#{?#{e|>=:%s,%s},%s,%s}},—}' \
    "$(widget_job)" "$value" "$CPU_CRITICAL" "$value" "$CPU_WARN" "$value" "$value" "$CPU_HIGH" "$(widget_text "$CPU_HIGH_ICON")" "$value" "$CPU_MEDIUM" "$(widget_text "$CPU_MEDIUM_ICON")" "$(widget_text "$CPU_LOW_ICON")"
}
airline_widget_sample () {
  _cpu_options "$@" || return 2
  local label user nice system idle iowait irq softirq steal rest total idle_total old_total old_idle delta busy
  read -r label user nice system idle iowait irq softirq steal rest < "${AIRLINE_CPU_STAT:-/proc/stat}" || return
  [[ "$label" == cpu ]] || return 2
  for label in "$user" "$nice" "$system" "$idle" "$iowait" "$irq" "$softirq" "$steal"; do
    [[ "$label" =~ ^[0-9]{1,15}$ ]] || return 2
  done
  # guest/guest_nice are already included in user/nice; do not count them twice.
  total=$((user+nice+system+idle+iowait+irq+softirq+steal)); idle_total=$((idle+iowait))
  old_total=0 old_idle=0
  if [[ -f "$AIRLINE_WIDGET_STATE_DIR/cpu" ]]; then read -r old_total old_idle < "$AIRLINE_WIDGET_STATE_DIR/cpu"; fi
  printf '%s %s\n' "$total" "$idle_total" > "$AIRLINE_WIDGET_STATE_DIR/cpu"
  if (( old_total == 0 || total <= old_total || idle_total < old_idle )); then printf '?\n'; return; fi
  delta=$((total-old_total)); busy=$((delta-(idle_total-old_idle)))
  (( busy >= 0 && busy <= delta )) || { printf '?\n'; return; }
  printf '%s\n' "$(( (100*busy+delta/2)/delta ))"
}
