# layouts/adapters/online — apply the palette to tmux-online-status's icon options (dynamic).
# shellcheck shell=bash
#
# A bash snippet sourced by `adapter use online` with PALETTE populated.
# Layout slot content: #{online_status}

opt_set_session "$AIRLINE_SESSION" @online_icon  "#[fg=${PALETTE[primary]}]●"
opt_set_session "$AIRLINE_SESSION" @offline_icon "#[fg=${PALETTE[stress]}]●"
