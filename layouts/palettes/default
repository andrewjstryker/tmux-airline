# Default palette — airline's shipped default look (256-color, dark).
#
# `airline init` loads this via `palette use default` when no palette is set. It is a
# distinct file (not an alias for `dark`) so the default can evolve independently; a
# user shadows it by registering a dir with their own `default`.

# Backgrounds — three greys stepping from medium-dark to near-black
set-option @airline-outer-bg "colour238"    # #444444
set-option @airline-middle-bg "colour236"   # #303030
set-option @airline-inner-bg "colour234"    # #1c1c1c

# Content colors — light greys with increasing brightness
set-option @airline-secondary "colour246"   # #949494
set-option @airline-primary "colour250"     # #bcbcbc
set-option @airline-emphasized "colour255"  # #eeeeee

# Semantic highlights
set-option @airline-active "colour214"      # warm amber
set-option @airline-special "colour134"     # purple
set-option @airline-alert "colour208"       # orange
set-option @airline-stress "colour196"      # red
set-option @airline-ok "colour114"          # green (success)

# tmux modes
set-option @airline-zoom "colour81"         # sky blue
set-option @airline-copy "colour75"         # steel blue
set-option @airline-monitor "colour109"     # muted teal

# vim: ft=tmux
