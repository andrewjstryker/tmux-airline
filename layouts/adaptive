#!/usr/bin/env bash
# Adaptive layout (init's default) — probe each adapted plugin via the TPM install
# convention and compose only what's present, so there are no empty blocks. Degrades to
# the dependency-free base (session · date) when nothing is installed.
airline_layout_configure () {
  local declare="$1"
  local right_out="%Y-%m-%d %H:%M"
  local -a adapters=()
  source "$AIRLINE_DIR/helpers/tpm-installed"

  "$declare" segment left-out  "#S"

  installed tmux-cpu && {
    "$declare" segment right-mid "#{cpu_fg_color}#{cpu_icon}"
    adapters+=(cpu)
  }
  installed tmux-online-status && {
    "$declare" segment left-mid "#{online_status}"
    adapters+=(online)
  }
  installed tmux-prefix-highlight && {
    "$declare" segment right-in "#{prefix_highlight}"
    adapters+=(prefix-highlight)
  }
  installed tmux-battery && {
    right_out="%Y-%m-%d %H:%M #{battery_color_fg}#{battery_icon}"
    adapters+=(battery)
  }

  "$declare" segment right-out "$right_out"
  (( ${#adapters[@]} == 0 )) || "$declare" adapter use "${adapters[@]}"
}
