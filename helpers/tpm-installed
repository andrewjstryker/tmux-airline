# helpers/tpm-installed — is a sibling tmux plugin installed?
#
# A bash helper for the TPM install-layout convention (plugins are cloned as named
# sibling dirs in the plugin path), NOT part of airline's API. A layout script sources
# it and calls `installed <repo>` to compose only what's present:
#
#   source "$AIRLINE_DIR/helpers/tpm-installed"
#   installed tmux-cpu && "$declare" adapter use cpu
#
# Checks the two standard locations: a sibling of airline (TPM's layout, covering a
# custom TMUX_PLUGIN_MANAGER_PATH since airline is a sibling) and the XDG plugins dir.

# shellcheck shell=bash

installed () {   # <repo>
  [[ -d "$AIRLINE_DIR/../$1" ]] ||
  [[ -d "${XDG_CONFIG_HOME:-$HOME/.config}/tmux/plugins/$1" ]]
}
