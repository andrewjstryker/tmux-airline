#!/usr/bin/env bash
#
# airline — the CLI parser and dispatcher.
#
# This file holds no command logic: it locates the install, points the mechanical
# layer at the right tmux server, sources the stack, and routes argv to a handler in
# api.sh. The supported surface and behaviour live there (and in DESIGN.md).

set -u

AIRLINE_DIR="${AIRLINE_DIR:-$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )}"

# Test/advanced seam: target a specific tmux server. AIRLINE_TMUX may carry args
# (e.g. "tmux -L mysock"); the word-splitting is intentional. tmux.sh's calls are
# late-bound, so defining this before sourcing is enough.
if [[ -n "${AIRLINE_TMUX:-}" ]]; then
  # shellcheck disable=SC2086
  tmux () { command ${AIRLINE_TMUX} "$@"; }
fi

# shellcheck source=tmux.sh
source "$AIRLINE_DIR/tmux.sh"
# shellcheck source=collections.sh
source "$AIRLINE_DIR/collections.sh"
# shellcheck source=render.sh
source "$AIRLINE_DIR/render.sh"
# shellcheck source=api.sh
source "$AIRLINE_DIR/api.sh"

# Dispatch: top-level verbs and nouns route to api.sh handlers; nouns carry their
# own verb (set/clear/show/use). Nothing here but routing.
cmd="${1:-}"; shift || true
case "$cmd" in
  init)     cmd_init    "$@" ;;   #| seed defaults, bind F12, publish path; then render
  apply)    cmd_apply   "$@" ;;   #| re-apply the layout and render from the source of truth
  show)     cmd_show    ;;        #| print the active configuration
  suspend)  cmd_suspend ;;        #| dim + trap the prefix (nested sessions)
  resume)   cmd_resume  ;;        #| undo suspend
  status)   cmd_status  "$@" ;;
  health)   cmd_health  "$@" ;;
  palette)  cmd_palette "$@" ;;
  segment)  cmd_segment "$@" ;;
  adapter)  cmd_adapter "$@" ;;
  layout)   cmd_layout  "$@" ;;
  _unfocus) cmd_unfocus "$@" ;;   # internal: pane-focus-out hook callback
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: airline help)" ;;
esac
