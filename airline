#!/usr/bin/env bash
#
# airline — the tmux-airline CLI: argument parsing, the command grammar, dispatch,
# and help, all in one file. Read this to know the entire command surface.
#
# It locates the install, points the mechanical layer at the right tmux server,
# sources the behaviour stack
# (tmux.sh → collections.sh → render.sh → runner.sh → api.sh), then parses argv and
# calls the api.sh function behind each verb. api.sh holds orchestration; the decision
# of which public entry point to call — the grammar — lives here.
#
# Grammar: a few top-level verbs (init/apply/show/…) plus config, signal, diagnostic,
# lifecycle, and runner nouns, each with its own verb set. Every noun's verbs live in
# a cmd_<noun> dispatcher below; help is generated from the `#| …` markers on the
# case arms, so the grammar documents itself.

set -u

AIRLINE_DIR="${AIRLINE_DIR:-$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )}"

# Test/advanced seam: target a specific tmux server. AIRLINE_TMUX may carry args
# (e.g. "tmux -L mysock"); the word-splitting is intentional. tmux.sh's calls are
# late-bound, so defining this before sourcing is enough.
if [[ -n "${AIRLINE_TMUX:-}" ]]; then
  # shellcheck disable=SC2086
  tmux () { command ${AIRLINE_TMUX} "$@"; }
fi

# shellcheck source=tmux.sh
source "$AIRLINE_DIR/tmux.sh"
# shellcheck source=collections.sh
source "$AIRLINE_DIR/collections.sh"
# shellcheck source=render.sh
source "$AIRLINE_DIR/render.sh"
# shellcheck source=runner.sh
source "$AIRLINE_DIR/runner.sh"
# shellcheck source=api.sh
source "$AIRLINE_DIR/api.sh"

#-----------------------------------------------------------------------------#
# Help — generated from the `#| …` markers on the case arms below, so the grammar
# is the single source of truth (no separate help text to keep in sync). Like `show`,
# it lists the top-level commands then recurses into each noun's dispatcher.
#-----------------------------------------------------------------------------#

# Print a source range's #|-annotated arms as "  verb   help". <file> <start> <end>.
_help_arms () {
  sed -n "/$2/,/$3/{ s/^[[:space:]]*\([a-zA-Z_][a-zA-Z0-9_-]*\))[^#]*#|[[:space:]]*\(.*\)/\1\t\2/p; }" "$1" \
    | while IFS=$'\t' read -r v d; do printf '  %-9s %s\n' "$v" "$d"; done
}

# One noun's verbs — the recursion target (also `<noun> help`). The dispatchers live in
# THIS file, so that's where the arms are read from.
_help_noun () {   # <noun>
  printf '%s:\n' "$1"
  _help_arms "$AIRLINE_DIR/airline" "^cmd_$1 () {" '^}'
}

usage () {
  printf 'airline — tmux-airline CLI\n\n'
  printf 'Commands:\n'
  _help_arms "$AIRLINE_DIR/airline" '^case ' '^esac'
  local n
  for n in palette segment adapter layout runner state status health problem lock; do
    printf '\n'; _help_noun "$n"
  done
  printf '\n  use loads a bare name from a registered dir; register blesses a location.\n'
  printf '  --transient clears a signal when you focus away from its window.\n'
}

#-----------------------------------------------------------------------------#
# Noun dispatchers — each parses its verb and makes exactly one public api.sh call.
# The `#| …` markers on the arms are the help source.
#-----------------------------------------------------------------------------#

cmd_state () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    suspend) api_state_suspend ;;   #| mute the palette + trap the prefix (session dormant)
    resume)  api_state_resume ;;    #| restore vibrant colours + release the prefix
    toggle)  api_state_toggle ;;    #| flip active/suspended
    show)    api_state_show ;;      #| print the current state (active | suspended)
    ""|-h|--help|help) _help_noun state ;;
    *) die "unknown state command: $verb" ;;
  esac
}

cmd_status () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    set)   api_status_set "$@" ;;   #| <key> <active|result|attention> [--transient] [-t <win>]
    clear) api_status_clear "$@" ;; #| <key> [-t <win>]
    show)  api_status_show "$@" ;;  #| [<key>] [-t <win>] — a window's app-status
    ""|-h|--help|help) _help_noun status ;;
    *) die "unknown status command: $verb" ;;
  esac
}

cmd_health () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    set)   api_health_set "$@" ;;   #| <key> <ok|warn|fail> [--transient] [-t <win>]
    clear) api_health_clear "$@" ;; #| <key> [-t <win>]
    show)  api_health_show "$@" ;;  #| [<key>] [-t <win>] — a window's health
    ""|-h|--help|help) _help_noun health ;;
    *) die "unknown health command: $verb" ;;
  esac
}

cmd_problem () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    set)   api_problem_set "$@" ;;   #| <session> <key> <ok|warn|fail> [<message>]
    clear) api_problem_clear "$@" ;; #| <session> <key>
    show)  api_problem_show "$@" ;;  #| [<session> [<key>]] — all sessions, one session, or one problem
    ""|-h|--help|help) _help_noun problem ;;
    *) die "unknown problem command: $verb" ;;
  esac
}

cmd_lock () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    show)  api_lock_show "$@" ;;  #| list outstanding transactions and whether their owner is active or stale
    clear) api_lock_clear "$@" ;; #| <session|window> <target> <namespace> — release one stale lock
    ""|-h|--help|help) _help_noun lock ;;
    *) die "unknown lock command: $verb" ;;
  esac
}

cmd_palette () {
  # A palette element is a public option (@airline-<element>). `set -g` supplies a
  # user default; `use` installs a session override for the whole set. Like segment,
  # the per-element CLI path is read-only — `show` is the discovery surface (bare for humans,
  # `show <field>` a raw value for scripts; `show name` is the active-palette read).
  local verb="${1:-}"; shift || true
  case "$verb" in
    show)      api_palette_show "$@" ;;      #| [name|<element>] — summary, or one field raw (`show name` for scripts)
    use)       api_palette_use "$@" ;;       #| <name> — load a palette (re-applies the layout)
    available) api_palette_available ;;      #| the palettes you can `use` (on the path)
    register)  api_palette_register "$@" ;; #| <dir> — add a palette search dir
    ""|-h|--help|help) _help_noun palette ;;
    *) die "unknown palette command: $verb" ;;
  esac
}

cmd_segment () {
  # A segment is a public option. Users provide defaults with `set -g`; layouts write
  # explicit session overrides. This noun is read-only — `show` is the discovery
  # surface (bare `show` lists every slot).
  local verb="${1:-}"; shift || true
  case "$verb" in
    show) api_segment_show "$@" ;;   #| [<slot>] — read one or all
    ""|-h|--help|help) _help_noun segment ;;
    *) die "unknown segment command: $verb" ;;
  esac
}

cmd_adapter () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    use)       api_adapter_use "$@" ;;       #| <name> — apply the palette to a plugin
    load)      api_adapter_load "$@" ;;      #| <path> — apply a one-off adapter script
    show)      api_adapter_show ;;           #| the applied adapters, one per line
    available) api_adapter_available ;;      #| the adapters you can `use` (on the path)
    register)  api_adapter_register "$@" ;; #| <dir> — add an adapter search dir
    ""|-h|--help|help) _help_noun adapter ;;
    *) die "unknown adapter command: $verb" ;;
  esac
}

cmd_layout () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    use)       api_layout_use "$@" ;;       #| <name> — run a composition (adapters + segments)
    load)      api_layout_load "$@" ;;      #| <path> — run a one-off layout script (records it)
    show)      api_layout_show "$@" ;;      #| [name|path] — the active layout (summary, or one field raw)
    available) api_layout_available ;;      #| the layouts you can `use` (on the path)
    register)  api_layout_register "$@" ;; #| <dir> — add a layout search dir
    ""|-h|--help|help) _help_noun layout ;;
    *) die "unknown layout command: $verb" ;;
  esac
}

cmd_runner () {
  local verb="${1:-}"; shift || true
  case "$verb" in
    use)       api_runner_use "$@" ;;       #| <name> — select the session's default runner
    load)      api_runner_load "$@" ;;      #| <path> — select a one-off runner implementation
    show)      api_runner_show "$@" ;;      #| [name|path] — the selected runner (summary, or one field raw)
    available) api_runner_available ;;       #| the runners you can `use` (on the path)
    register)  api_runner_register "$@" ;;  #| <dir> — add a runner search dir
    run)       api_runner_run "$@" ;;        #| [--here|--pane|--window] [--with <name>] -- <command> [<arg>...]
    ""|-h|--help|help) _help_noun runner ;;
    *) die "unknown runner command: $verb" ;;
  esac
}

#-----------------------------------------------------------------------------#
# Dispatch — top-level verbs. Config/dynamic nouns delegate to their cmd_<noun>
# parser above; the rest call the api.sh behaviour function directly.
#-----------------------------------------------------------------------------#
cmd="${1:-}"; shift || true
case "$cmd" in
  init)     api_init    "$@" ;;   #| seed defaults, register search paths, publish the CLI handle; then render
  apply)    api_apply   "$@" ;;   #| re-apply the layout and render from the source of truth
  show)     api_show    "$@" ;;   #| print the active configuration
  state)    cmd_state   "$@" ;;
  status)   cmd_status  "$@" ;;
  health)   cmd_health  "$@" ;;
  problem)  cmd_problem "$@" ;;
  lock)     cmd_lock    "$@" ;;
  palette)  cmd_palette "$@" ;;
  segment)  cmd_segment "$@" ;;
  adapter)  cmd_adapter "$@" ;;
  layout)   cmd_layout  "$@" ;;
  runner)   cmd_runner  "$@" ;;
  _init-session) api_init_session "$@" ;; # internal: after-new-session hook callback
  _unfocus) api_unfocus "$@" ;;           # internal: pane-focus-out hook callback
  _run)     api_runner_exec "$@" ;;        # internal: spawned-pane runner callback
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $cmd (try: airline help)" ;;
esac
