#!/bin/sh
# PATH shim for the tmux-airline CLI. The plugin publishes its real launcher in
# @airline-cli when initialized, so this remains valid if the plugin moves.

set -u

if [ -n "${AIRLINE_TMUX:-}" ]; then
  # AIRLINE_TMUX intentionally supports a command plus arguments, matching the
  # real launcher's test/advanced-server seam.
  # shellcheck disable=SC2086
  cli=$(command $AIRLINE_TMUX show-options -gqv @airline-cli 2>/dev/null) || cli=
else
  cli=$(tmux show-options -gqv @airline-cli 2>/dev/null) || cli=
fi

if [ -z "$cli" ]; then
  printf '%s\n' \
    'airline: tmux-airline is not initialized; start or reload tmux first' >&2
  exit 1
fi

if [ ! -x "$cli" ]; then
  printf 'airline: configured CLI is not executable: %s\n' "$cli" >&2
  exit 1
fi

exec "$cli" "$@"
